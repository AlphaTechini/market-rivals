# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Storage and Realtime
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"
SUPABASE_AVATARS_BUCKET="avatars"
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="replace-with-public-anon-key"

# DreamDEX Shannon testnet
PUBLIC_DREAMDEX_INDEXER_URL="https://dev.smk.somnia.host/v1/graphql"
# Optional override. The SDK's somniaShannon definition provides the default.
PUBLIC_DREAMDEX_WS_RPC_URL="wss://api.infra.testnet.somnia.network/ws"
# Optional server-side HTTP RPC override for transaction verification.
DREAMDEX_RPC_URL="https://api.infra.testnet.somnia.network"
